# src/live/brain.ts
ANTHROPIC_API_KEY=sk-ant-...

# src/live/pons.ts  (Bitquery streaming GraphQL)
BITQUERY_TOKEN=ory_at_...

# src/live/execute.ts  — leave DRY_RUN=1 unless you mean it
DRY_RUN=1
RH_RPC_URL=https://rpc.robinhood-chain.example
RH_PRIVATE_KEY=0x...
PONS_ROUTER=0x0000000000000000000000000000000000000000

# src/run.ts
MODE=sim

# Only needed if an agent is wired to that house (FORGE picker / REWIRE).
OPENAI_API_KEY=
XAI_API_KEY=
# Wire the roster in order at boot, e.g. xai,openai — anything past the end
# of the list keeps the default (anthropic).
AGENT_PROVIDERS=

# npm run paper uses public Coinbase data; no credentials are needed.
# MODE=chain-demo selects legacy chain identities / simulated prices.
# .env is a template; export variables in your shell for CLI commands.

# Sensitive operation owner and deterministic market-rotation controls.
OWNER_ID=
ROTATION_INTERVAL_TICKS=30
ROTATION_COOLDOWN_TICKS=120
ROTATION_MIN_REPEAT_GAP_TICKS=90
ROTATION_ANTI_MANIPULATION_WINDOW_TICKS=300
ROTATION_MAX_PROMOTIONS_PER_WINDOW=2
